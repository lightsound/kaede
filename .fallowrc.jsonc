{
  "$schema": "./node_modules/fallow/schema.json",

  // Only file-relative bases inside this directory may be `extends`ed. We use
  // none; sealing keeps a remote/npm base from ever being pulled in silently.
  "sealed": true,

  "workspaces": {
    "patterns": ["packages/*"],
  },

  // Generated SpacetimeDB bindings: not ours to prune.
  "ignorePatterns": ["**/module_bindings/**"],
  // spacetimedb: used by the generated (ignored) bindings in packages/client.
  // @effect/platform-node: alchemy CLI のランタイム peer 依存。infra/ のコードは
  // import しないが、ベータ採用条件のバージョン厳密ピン留めのために明示している。
  // @posthog/cli: @posthog/rollup-plugin がビルド時に node_modules/.bin から
  // 起動するバイナリ。コードは import しないが、プラグインの探索範囲
  // （対象パッケージと祖先の node_modules/.bin）に置くため直接依存にしている。
  "ignoreDependencies": ["spacetimedb", "@effect/platform-node", "@posthog/cli"],

  // Entry-point exports are checked like any other export, so a stray or
  // misspelled export in an index barrel is reported instead of auto-credited.
  "includeEntryExports": true,

  // TypeScript semantic pass: project-wide symbol use, provenance, and public
  // API surface. `complete` makes a partial semantic result fail the gate
  // rather than silently degrade to syntactic-only answers.
  "typeAware": {
    "enabled": true,
    "projects": [
      "packages/shared/tsconfig.json",
      "packages/client/tsconfig.json",
      "packages/server/tsconfig.json",
      "packages/e2e/tsconfig.json",
    ],
    "require": "complete",
  },

  // The most aggressive blinding, so renamed-variable (Type-2) clones are
  // caught too. `minOccurrences` is spelled out at fallow's own minimum: a
  // pair is already a duplicate in a repo this small.
  "duplicates": {
    "mode": "semantic",
    "minOccurrences": 2,
  },

  // The architecture the README describes, enforced: shared is the leaf that
  // both sides replay physics through, and client/server never see each other.
  "boundaries": {
    "zones": [
      { "name": "shared", "patterns": ["packages/shared/**"] },
      { "name": "client", "patterns": ["packages/client/**"] },
      { "name": "server", "patterns": ["packages/server/**"] },
      { "name": "e2e", "patterns": ["packages/e2e/**"] },
      // IaC (Alchemy / cf / wrangler configs). docs/VISION.md keeps Alchemy and
      // Effect inside this directory, so no other zone may import it.
      { "name": "infra", "patterns": ["infra/**"] },
    ],
    "rules": [
      { "from": "shared", "allow": [] },
      { "from": "client", "allow": ["shared"] },
      { "from": "server", "allow": ["shared"] },
      // E2E drives the running app from outside through the browser, so it
      // never imports client/server code. shared is allowed for the hook
      // contract (E2EHook) and the physics constants assertions derive from.
      { "from": "e2e", "allow": ["shared"] },
      // The app never imports infra, and infra reads no app code either.
      { "from": "infra", "allow": [] },
    ],
    "coverage": {
      "requireAllFiles": true,
      // The only source files outside the zones. Listed by name rather than
      // as a glob, so a future root-level source file or script is not
      // exempted silently — it has to be classified or added here
      // deliberately. describe-table-names.mjs is a standalone helper that
      // backup-maincloud.sh runs with node (fallow checks unreached files
      // against boundaries since 3.31).
      "allowUnmatched": ["vite.config.ts", "scripts/describe-table-names.mjs"],
    },
  },

  "health": {
    // Real per-function CRAP instead of coverage estimated from the module
    // graph, which scores well-tested code as risky. REQUIRED, not optional:
    // fallow exits 2 if this file is missing, so run `bun run test:coverage`
    // first (`bun run analyze` and the CI job both do).
    "coverage": "coverage/coverage-final.json",
  },

  // `fallow audit` gates on every finding in the changed files, not just the
  // ones this changeset introduced.
  "audit": {
    "gate": "all",
  },

  // Every rule fallow ships at `error` (the complexity-* rules already default
  // to `error`; their thresholds live under `health`). The defaults leave
  // cleanup, styling, and framework-hygiene rules at `warn` and the opinionated
  // ones `off`; we want all of them reported, and gating wherever fallow lets
  // severity drive the exit code (see `feature-flags` below for the one rule
  // where it does not).
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "private-type-leaks": "error",
    "deprecated-exports-in-use": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unused-store-members": "error",
    "unprovided-injects": "error",
    "unrendered-components": "error",
    "unused-component-props": "error",
    "absent-component-props": "error",
    "unused-component-emits": "error",
    "unused-component-inputs": "error",
    "unused-component-outputs": "error",
    "unused-svelte-events": "error",
    "unused-server-actions": "error",
    "unused-load-data-keys": "error",
    "unused-effect-layers": "error",
    "unused-tagged-errors": "error",
    "unproduced-catch-tags": "error",
    "prop-drilling": "error",
    "thin-wrapper": "error",
    "duplicate-prop-shape": "error",
    "css-token-drift": "error",
    "css-duplicate-block": "error",
    "css-selector-complexity": "error",
    "css-dead-surface": "error",
    "css-broken-reference": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "package-cycle": "error",
    "boundary-violation": "error",
    "coverage-gaps": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "unused-catalog-entries": "error",
    "empty-catalog-groups": "error",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "error",
    "misconfigured-dependency-overrides": "error",
    "security-client-server-leak": "error",
    "security-sink": "error",
    "policy-violation": "error",
    "invalid-client-export": "error",
    "mixed-client-server-barrel": "error",
    "misplaced-directive": "error",
    "route-collision": "error",
    "dynamic-segment-name-conflict": "error",
    "weakened-tests": "error",
    "added-suppression": "error",
    "test-only-branch": "error",
    "diverged-clone-sibling": "error",
    "added-dependency": "error",

    // An inventory rule rather than a defect check: it reports that a feature
    // flag exists. Promoted anyway so there is no deviation from the policy —
    // verified that a detected flag still exits 0, so this reports without
    // gating. `fallow flags` shows the inventory on demand.
    "feature-flags": "error",
  },
}
