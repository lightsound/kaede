// 通話 API Worker (kaede-call) の wrangler 手動デプロイ用設定(Alchemy が
// 使えないときの逃げ道 — wrangler.jsonc と同じ役割分担)。alchemy.run.ts の
// CallApi と同じ Worker に同じ構成でデプロイする。乖離させないこと。
// シークレットはファイルに書けないため別途:
//   pnpm --filter @kaede/infra exec wrangler secret put REALTIMEKIT_API_TOKEN --config wrangler-call.jsonc
//   pnpm --filter @kaede/infra exec wrangler secret put CALL_SERVICE_SECRET --config wrangler-call.jsonc
//   pnpm --filter @kaede/infra exec wrangler secret put R2_ACCESS_KEY_ID --config wrangler-call.jsonc
//   pnpm --filter @kaede/infra exec wrangler secret put R2_SECRET_ACCESS_KEY --config wrangler-call.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaede-call",
  "account_id": "751c8a59858c9c04a8e722df7330444d",
  "compatibility_date": "2026-08-01",
  "main": "../packages/worker/src/index.ts",
  "workers_dev": true,
  "vars": {
    "REALTIMEKIT_APP_ID": "84053947-0a8e-4b23-840a-a47731b7310b",
    "CLOUDFLARE_ACCOUNT_ID": "751c8a59858c9c04a8e722df7330444d",
    "CLERK_ISSUER": "https://clerk.kaede.town",
    "CLERK_AUDIENCE": "kaede-spacetimedb",
    "SPACETIME_HOST_URL": "https://maincloud.spacetimedb.com",
    "SPACETIME_DB_NAME": "kaede",
    "ALLOWED_ORIGINS": "https://kaede.town,https://kaede.kaede-751.workers.dev",
    "R2_BUCKET_NAME": "kaede-recordings"
  },
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "kaede-recordings",
      "preview_bucket_name": "kaede-recordings-preview"
    }
  ]
}
