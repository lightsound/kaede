// wrangler での手動デプロイ用の設定(Alchemy が使えないときの逃げ道)。
// Alchemy の alchemy.run.ts と同じ Worker(kaede)に同じアセット構成で
// デプロイする。乖離させないこと。手順は README の「デプロイ(公開手順)」を参照。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaede",
  "account_id": "751c8a59858c9c04a8e722df7330444d",
  "compatibility_date": "2026-08-01",
  // alchemy.run.ts の domain: 'kaede.town' と対になる設定。wrangler は
  // routes の custom_domain でカスタムドメインを宣言する。
  "routes": [{ "pattern": "kaede.town", "custom_domain": true }],
  // routes を書くと wrangler は workers_dev を false と推定して
  // *.workers.dev の配信を落としてしまうため明示する(Bugbot 指摘)。
  // workers.dev URL は Clerk 本番切替の移行中 URL として併存させる方針
  // (alchemy.run.ts の domain コメント参照)で、Alchemy 側の既定
  // (WorkersDevConfig.enabled: true)とも揃える。
  "workers_dev": true,
  "assets": {
    "directory": "../packages/client/dist",
    "not_found_handling": "single-page-application"
  }
}
