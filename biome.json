{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/module_bindings",
      "!infra/.alchemy",
      "!pnpm-lock.yaml",
      "!**/skills/sp-*",
      "!**/skills/stripe-projects-cli",
      "!.github/workflows/pullfrog.yml",
      "!docs/factory-yield.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "yaml": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
