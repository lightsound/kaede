{
  "name": "maple-like",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @maple/client dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "audit": "fallow audit",
    "analyze": "pnpm test:coverage && fallow"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "fallow": "^3.10.0",
    "vitest": "^4.1.10"
  }
}
