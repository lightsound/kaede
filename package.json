{
  "name": "kaede",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter @kaede/client dev",
    "typecheck": "vp check",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "pnpm --filter @kaede/e2e test",
    "lint": "vp check && import-lint",
    "lint:imports": "import-lint",
    "format": "vp fmt --write",
    "analyze": "pnpm test:coverage && fallow && fallow security",
    "analyze:changed": "pnpm test:coverage && fallow audit"
  },
  "devDependencies": {
    "@import-lint/cli": "0.1.10",
    "@vitest/coverage-v8": "^5.0.5",
    "fallow": "^3.37.0",
    "vite-plus": "1.4.0"
  }
}
