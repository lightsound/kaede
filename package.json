{
  "name": "kaede",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "dev": "pnpm --filter @kaede/client dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @kaede/e2e test",
    "lint": "biome check . && import-lint",
    "lint:imports": "import-lint",
    "format": "biome check --write .",
    "analyze": "pnpm test:coverage && fallow && fallow security",
    "analyze:changed": "pnpm test:coverage && fallow audit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@import-lint/cli": "0.1.9",
    "@vitest/coverage-v8": "^5.0.1",
    "fallow": "^3.27.0",
    "vitest": "^5.0.1"
  }
}
