// .importlintrc.jsonc
//
// Every first-level directory below packages/*/src is an encapsulation
// boundary. This makes enforcement fail-closed for future modules: `src/chat/`
// is sealed even if its author forgets the naming convention. `*.package`
// additionally supports explicit nested boundaries.
//
// Everything inside a boundary imports freely from everything else inside it;
// nothing outside can import from it unless the export is tagged `@public`, or
// re-exported (unannotated) from the boundary's own index.ts. The index
// loophole below promotes those exports to the parent's package, so wider
// exposure is always a deliberate, visible one-level-at-a-time edit.
{
  // Application source lives under packages/. Root tooling files remain in
  // the project-wide package and do not need directory-level boundaries.
  "include": ["packages"],

  // Tests intentionally reach package-private internals; generated bindings
  // are owned by the SpacetimeDB CLI and must not acquire hand-written tags.
  "exclude": ["**/test/**", "**/module_bindings/**"],

  "rules": {
    "package-access": {
      "severity": "error",

      // Treat a file named "index.{js,ts,jsx,tsx,mjs,cjs,...}" as if its parent
      // directory were the exporting file, for package-boundary purposes. This is
      // the escape valve for the `*.package` convention: a bare re-export from a
      // boundary's index.ts promotes that export to the parent's package.
      "indexLoophole": true,

      "filenameLoophole": false,

      "defaultImportability": "package",

      "treatSelfReferenceAs": "internal",

      // Generated SpacetimeDB bindings are consumed as an opaque public API;
      // they must not acquire hand-written access annotations.
      "excludeSourcePatterns": ["**/module_bindings/**"],

      // Glob patterns identifying "package" directories (matched against both
      // basename and project-relative path). A file with no matching ancestor
      // belongs to a single project-root package. Every first-level src/
      // directory is automatically sealed so a future `src/chat/` cannot
      // silently skip enforcement. `*.package` additionally permits explicit
      // nested boundaries.
      "packageDirectory": ["packages/*/src/*", "**/*.package"],
    },
  },
}
