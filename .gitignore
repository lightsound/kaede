node_modules/
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
__pycache__/
.DS_Store
spacetime.local.json
.fallow/

# 本番データベースのエクスポート先(scripts/backup-maincloud.sh)。
# 個人情報を含む成果物なのでリポジトリには入れない — docs/backup-restore.md 参照。
backups/

# Alchemy が Worker エントリ(packages/worker)をバンドルするときに
# パッケージ脇へ作る作業キャッシュ。ステートではないので共有しない。
packages/*/.alchemy/

# 通話 API Worker のローカル開発シークレット(README「通話 API Worker」)。
infra/.dev.vars

# wrangler dev の作業キャッシュ(通話 API Worker のローカル開発で生成される)。
infra/.wrangler/

# Alchemy のステート: 共有するのは prod ステージだけ(README 参照)。
# それ以外のステージ(既定の dev_$USER を含む)・ログ・バージョンチェックの
# キャッシュは個人環境の産物なので共有しない。
infra/.alchemy/state/*/*/
!infra/.alchemy/state/*/prod/
infra/.alchemy/log/
infra/.alchemy/version-check.json

# アセットの生成原本(グリーンバックのシート等 *-original.*)は Git に
# 入れない(1 枚 300KB〜1.3MB で再生成のたびに clone が肥大するため —
# ROADMAP Phase 5 ①b⑶)。正の置き場所は R2 バケット kaede-asset-originals
# (scripts/upload-asset-originals.py がアップロードして order.json に
# sha256 を記録し、取り込みスクリプトが必要時に取得してここへ書き戻す)。
# パターンは upload スクリプトの `*-original.*` と揃える(thermos Low)。
packages/client/src/**/*-original.*

.projects/cache
.projects/vault
.projects/state.test.json
.projects/state.local.test.json
.env
.env.*
!.env.example
